{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo",
    "padding": {
      "top": 1,
      "left": 1
    },
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "#94e2d5",
    },
  },
  "modules": [
    {
      "type": "title",
      "key": " ",
      "color": {
        "user": "#a6e3a1",
        "at": "#cdd6f4",
        "host": "#89dceb",
      },
    },
    "break",
    {
      "type": "os",
      "key": " 󰣛",
      "format": "{pretty-name}",
    },
    {
      "type": "kernel",
      "key": " ",
      "format": "{1} {2}",
    },
    {
      "type": "uptime",
      "key": " 󰅐",
    },
    {
      "type": "command",
      "key": " 󰔠",
      "text": "date -d$(ls -alct / --time-style=full-iso|tail -1|awk '{print $6}') +'Spawned on %b %d %G'",
      "shell": "/usr/bin/bash",
    },
    "break",
    {
      "type": "host",
      "key": " 󰾰",
    },
    {
      "type": "cpu",
      "key": " 󰻠",
    },
    {
      "type": "gpu",
      "key": " 󰍛",
    },
    {
      "type": "memory",
      "key": " ",
    },
    {
      "type": "disk",
      "key": " ",
    },
    {
      "type": "display",
      "key": " 󰍹",
    },
    {
      "type": "battery",
      "key": " ",
    },
    {
      "type": "gamepad",
      "key": " 󰖺",
    },
    "break",
    {
      "type": "de",
      "key": " 󰕮",
    },
    {
      "type": "wm",
      "key": " ",
    },
    {
      "type": "shell",
      "key": " ",
    },
    {
      "type": "terminal",
      "key": " ",
    },
    {
      "type": "packages",
      "key": " 󰏖",
    },
    "break",
    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "circle",
    },
  ],
}
